PippengerSpencerPolynomial : Prop
@[expose] def RefinedAbsorption.External.PippengerSpencerPolynomial : Prop :=
∀ (k : ℕ),
  2 ≤ k →
    ∀ (δ : ℝ),
      0 < δ →
        δ < 1 →
          ∃ γ,
            0 < γ ∧
              ∃ D₀,
                ∀ (V : Type) [Fintype V] [inst : DecidableEq V] (H : Finset (Finset V)) (D : ℝ),
                  D₀ ≤ D →
                    PippengerSpencer.IsUniform H k →
                      (∀ (v : V), ↑(PippengerSpencer.degree H v) ≤ D) →
                        (∀ (u v : V), u ≠ v → ↑(PippengerSpencer.codegree H u v) ≤ D ^ (1 - δ)) →
                          ↑H.card ≤ Real.exp (D ^ γ) →
                            ∃ m c, ↑m ≤ D + D ^ (1 - γ) ∧ PippengerSpencer.IsProperEdgeColouring H m c
NashWilliamsExternal : Prop
@[expose] def RefinedAbsorption.External.NashWilliamsExternal : Prop :=
∃ N,
  ∀ (V : Type) [inst : Fintype V] [DecidableEq V] (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj],
    N ≤ Fintype.card V →
      NashWilliams.IsTriangleDivisible G →
        3 * Fintype.card V ≤ 4 * G.minDegree → NashWilliams.HasTriangleDecomposition G
@steiner_quantitatively_almost_resolvable : ∀ {q r : ℕ},
  PippengerSpencerPolynomial →
    2 ≤ r →
      r < q →
        ∃ γ,
          0 < γ ∧
            γ < 1 ∧
              ∃ n₀,
                ∀ n ≥ n₀,
                  ∀ (𝒮 : Finset (Finset (Fin n))),
                    RefinedAbsorption.IsSteinerSystem q r 𝒮 →
                      ∃ m c,
                        ↑((n - 1).choose (r - 1)) / ↑((q - 1).choose (r - 1)) ≤ ↑m ∧
                          ↑m ≤
                              ↑((n - 1).choose (r - 1)) / ↑((q - 1).choose (r - 1)) +
                                (↑((n - 1).choose (r - 1)) / ↑((q - 1).choose (r - 1))) ^ (1 - γ) ∧
                            ∀ B ∈ 𝒮, ∀ B' ∈ 𝒮, B ≠ B' → c B = c B' → Disjoint B B'
