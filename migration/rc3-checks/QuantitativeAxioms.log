nash_williams_scheduled_decomposition : PippengerSpencerPolynomial →
  NashWilliamsExternal →
    ∃ γ,
      0 < γ ∧
        γ < 1 ∧
          ∃ n₀,
            ∀ (V : Type) [inst : Fintype V] [DecidableEq V] (G : SimpleGraph V) [inst_2 : DecidableRel G.Adj],
              n₀ ≤ Fintype.card V →
                NashWilliams.IsTriangleDivisible G →
                  3 * Fintype.card V ≤ 4 * G.minDegree →
                    ∃ T,
                      NashWilliams.IsTriangleDecomposition G T ∧
                        ∃ m c,
                          PippengerSpencer.IsProperEdgeColouring T m c ∧
                            ↑G.maxDegree / 2 ≤ ↑m ∧ ↑m ≤ ↑G.maxDegree / 2 + (↑G.maxDegree / 2) ^ (1 - γ)
